#!/usr/bin/env bash

set -u
set -o pipefail

readonly DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly DESKTOP_DIR="$DATA_HOME/applications"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
readonly SCRIPT_DIR
readonly SCAN_SCRIPT="$SCRIPT_DIR/webapp-manager-scan.pl"

json_error() {
  local code="$1"
  local message="$2"
  jq -cn --arg code "$code" --arg message "$message" \
    '{ok:false,error:{code:$code,message:$message}}'
}

byte_length() {
  LC_ALL=C printf '%s' "$1" | LC_ALL=C wc -c
}

within_bytes() {
  local value="$1"
  local maximum="$2"
  (( $(byte_length "$value") <= maximum ))
}

is_safe_name() {
  local value="$1"
  [[ -n "$value" ]] && within_bytes "$value" 120 || return 1
  [[ "$value" != "." && "$value" != ".." && "$value" != "all" ]] || return 1
  [[ "$value" != *"/"* && "$value" != *"\\"* ]] || return 1
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* && "$value" != *$'\t'* ]] || return 1
}

is_safe_url() {
  local value="$1"
  within_bytes "$value" 2048 || return 1
  [[ "$value" =~ ^[Hh][Tt][Tt][Pp][Ss]?://[^[:space:]\"\']+$ ]]
}

scan_apps() {
  "$SCAN_SCRIPT" "$DESKTOP_DIR" "$DATA_HOME"
}

safe_desktop_launch() {
  local file="$1"
  "$SCAN_SCRIPT" --read-launch "$file" 2>/dev/null
}

install_app() {
  local name="" url="" icon=""
  while (($# > 0)); do
    case "$1" in
      --name) (($# >= 2)) || { json_error "missing-name" "Missing app name."; return 2; }; name="$2"; shift 2 ;;
      --url) (($# >= 2)) || { json_error "missing-url" "Missing app URL."; return 2; }; url="$2"; shift 2 ;;
      --icon) (($# >= 2)) || { json_error "missing-icon" "Missing icon value."; return 2; }; icon="$2"; shift 2 ;;
      *) json_error "unknown-argument" "Unknown install argument."; return 2 ;;
    esac
  done

  is_safe_name "$name" || { json_error "invalid-name" "Choose a safe app name."; return 2; }
  is_safe_url "$url" || { json_error "invalid-url" "Use a complete http:// or https:// URL."; return 2; }
  if ! within_bytes "$icon" 256; then
    json_error "invalid-icon" "Keep the icon value within 256 UTF-8 bytes."
    return 2
  fi
  if [[ -n "$icon" && ! "$icon" =~ ^[Hh][Tt][Tt][Pp][Ss]?://[^[:space:]\"\']+$ && ! "$icon" =~ ^[A-Za-z0-9._-]+$ ]]; then
    json_error "invalid-icon" "Use an icon name or an http(s) icon URL."
    return 2
  fi

  local output install_status
  output="$(omarchy webapp install "$name" "$url" "$icon" 2>&1 | head -c 1001)"
  install_status=$?
  if (( install_status == 0 )); then
    jq -cn --arg output "${output:0:1000}" '{ok:true,output:$output}'
    return 0
  fi
  json_error "install-failed" "${output:0:1000}"
  return 1
}

user_desktop_file() {
  local candidate="$1"
  local expected_dir resolved
  [[ ! -L "$candidate" ]] || return 1
  expected_dir="$(realpath -m -- "$DESKTOP_DIR")" || return 1
  resolved="$(realpath -e -- "$candidate" 2>/dev/null)" || return 1
  [[ "$resolved" == "$expected_dir/"*.desktop ]] || return 1
  printf '%s\n' "$resolved"
}

remove_app() {
  local requested="$1"
  local file
  file="$(user_desktop_file "$requested")" || {
    json_error "unsafe-path" "Only a user-owned web-app launcher can be removed."
    return 2
  }

  local launch_response
  launch_response="$(safe_desktop_launch "$file")" || {
    json_error "unsafe-path" "Only a user-owned web-app launcher can be removed."
    return 2
  }
  jq -e '.ok == true and (.launch.kind == "webapp" or .launch.kind == "handler")' \
    <<<"$launch_response" >/dev/null || {
    json_error "not-webapp" "The selected desktop file is not an Omarchy web app."
    return 2
  }

  if ! gio trash -- "$file"; then
    json_error "remove-failed" "Could not move the launcher to the user trash."
    return 1
  fi
  update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
  jq -cn --arg file "$file" '{ok:true,desktopFile:$file}'
}

launch_app() {
  local requested="$1"
  local file desktop_id launch_response kind url handler handler_path
  file="$(user_desktop_file "$requested")" || {
    json_error "unsafe-path" "Only a user-owned launcher can be opened."
    return 2
  }
  launch_response="$(safe_desktop_launch "$file")" || {
    json_error "unsafe-path" "Only a user-owned launcher can be opened."
    return 2
  }
  desktop_id="$(basename "$file" .desktop)"

  kind="$(jq -r '.launch.kind // ""' <<<"$launch_response")"
  case "$kind" in
    webapp)
      url="$(jq -r '.launch.url // ""' <<<"$launch_response")"
      is_safe_url "$url" || { json_error "invalid-url" "The launcher URL is invalid."; return 2; }
      [[ -x /usr/bin/omarchy-launch-webapp ]] || { json_error "no-launcher" "The Omarchy web-app launcher is unavailable."; return 1; }
      /usr/bin/omarchy-launch-webapp "$url" >/dev/null 2>&1 &
      ;;
    handler)
      handler="$(jq -r '.launch.handler // ""' <<<"$launch_response")"
      [[ "$handler" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || { json_error "invalid-handler" "The web-app handler is invalid."; return 2; }
      handler_path="/usr/bin/omarchy-webapp-handler-$handler"
      [[ -f "$handler_path" && -x "$handler_path" && ! -L "$handler_path" && "$(stat -c %u -- "$handler_path")" == 0 ]] || {
        json_error "invalid-handler" "The trusted Omarchy web-app handler is unavailable."
        return 1
      }
      "$handler_path" >/dev/null 2>&1 &
      ;;
    *)
      json_error "not-webapp" "The selected desktop file is not an Omarchy web app."
      return 2
      ;;
  esac
  jq -cn --arg desktopId "$desktop_id" '{ok:true,desktopId:$desktopId}'
}

main() {
  local action="${1:-}"
  shift || true
  case "$action" in
    scan) (($# == 0)) || { json_error "unexpected-argument" "scan takes no arguments."; return 2; }; scan_apps ;;
    install) install_app "$@" ;;
    remove)
      (($# == 2)) || { json_error "invalid-remove" "A desktop file path is required."; return 2; }
      [[ "$1" == "--desktop-file" ]] || { json_error "invalid-remove" "A desktop file path is required."; return 2; }
      remove_app "$2"
      ;;
    launch)
      (($# == 2)) || { json_error "invalid-launch" "A desktop file path is required."; return 2; }
      [[ "$1" == "--desktop-file" ]] || { json_error "invalid-launch" "A desktop file path is required."; return 2; }
      launch_app "$2"
      ;;
    *) json_error "unknown-action" "Unknown Web App Manager action."; return 2 ;;
  esac
}

main "$@"
